{
  "manifest_version": 3,
  "name": "Send to Google Keep",
  "short_name": "Send to Keep",
  "version": "0.2.8",
  "description": "Capture to Google Keep with one reusable compact popup, optional review, and independent recovery records. No Google OAuth.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting",
    "storage",
    "notifications",
    "alarms"
  ],
  "optional_host_permissions": [
    "https://keep.google.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Send to Google Keep",
    "default_icon": {
      "16": "images/icon16.png",
      "32": "images/icon32.png",
      "48": "images/icon48.png"
    }
  },
  "icons": {
    "16": "images/icon16.png",
    "32": "images/icon32.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
